{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"files": {
		"includes": ["**", "!**/dist", "!**/node_modules", "!**/coverage", "!**/.context"]
	}
}
